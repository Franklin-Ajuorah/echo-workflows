      },
      "id": "e01d1b4f-394a-4872-9116-c3d92406c98d",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "f12b40a1-e395-4e5c-b598-03b7ab1b616e"
    },
    {
      "parameters": {
        "jsCode": "// Get the raw input from the Webhook node\nconst raw = $input.first().json;\n\n// Try to find the parsed body. It could be in different places:\n//  - raw.body (when Content-Type is set correctly)\n//  - raw.body as a string (when Content-Type is missing)\n//  - fallback to empty object\nlet incoming = raw.body ?? {};\n\n// If the body came as a string, parse it\nif (typeof incoming === \"string\") {\n  try {\n    incoming = JSON.parse(incoming);\n  } catch (e) {\n    incoming = {};\n  }\n}\n\n// Extract the fields we care about\nconst name = incoming.name ?? \"Unbekannt\";\nconst message = incoming.message ?? \"Keine Nachricht\";\n\n// Build a clean response object\nreturn [{\n  json: {\n    name: name,\n    message: message,\n    received_at: new Date().toISOString(),\n    greeting: `Hallo ${name}! ${message}`\n  }\n}];"
      },
      "id": "c7da80fd-2140-4047-b35f-663c7e94a1dd",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
