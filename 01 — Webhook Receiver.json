      "parameters": {
        "jsCode": "// Get the incoming data from the Webhook node\nconst incoming = $input.first().json.body;\n\n// Extract the fields we care about\nconst name = incoming.name ?? \"Unbekannt\";\nconst message = incoming.message ?? \"Keine Nachricht\";\n\n// Build a clean response object\nreturn [{\n  json: {\n    name: name,\n    message: message,\n    received_at: new Date().toISOString(),\n    greeting: `Hallo ${name}! ${message}`\n  }\n}];"
      },
